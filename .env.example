# Local Docker overrides. MySQL and RabbitMQ defaults are only for localhost development.
# start.ps1 fills the empty trusted-token and Nacos values in ignored .env.
MYSQL_PASSWORD=123456
RABBITMQ_USERNAME=hmdp
RABBITMQ_PASSWORD=hmdp-rabbit
ELASTICSEARCH_VERSION=8.18.1
ELASTICSEARCH_IMAGE=m.daocloud.io/docker.elastic.co/elasticsearch/elasticsearch
# HMDP_INTERNAL_TOKEN=
NACOS_AUTH_ENABLE=false
# NACOS_AUTH_TOKEN=
# NACOS_AUTH_IDENTITY_KEY=
# NACOS_AUTH_IDENTITY_VALUE=
# NACOS_USERNAME=
# NACOS_PASSWORD=
HMDP_ADMIN_USER_IDS=1

# 在线知识共用发布；发布专用凭证只配置到AI服务，留空时管理接口拒绝所有请求。
HMDP_AI_KNOWLEDGE_RESOURCE=shared
HMDP_AI_KNOWLEDGE_NAMESPACE=customer-service
HMDP_AI_KNOWLEDGE_PUBLISH_TOKEN=

# AI chat is disabled by default, so no external API key is required for startup.
SPRING_AI_CHAT_CLIENT_ENABLED=false
# Set to openai together with the client flag and API key when enabling DeepSeek/OpenAI-compatible chat.
SPRING_AI_MODEL_CHAT=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI-compatible Embedding endpoint for RAG.
LANGCHAIN4J_EMBEDDING_ENABLED=false
HMDP_AI_RAG_VECTOR_ENABLED=false
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Milvus vector storage. Docker Compose uses the internal service name "milvus".
MILVUS_ENABLED=true
MILVUS_DATABASE=default
MILVUS_EMBEDDING_DIMENSION=1536
MILVUS_AUTO_IMPORT=true
MILVUS_AUTO_FLUSH_ON_INSERT=true
HMDP_AI_RAG_MEMORY_SHORT_TERM_ROUNDS=3
HMDP_AI_RAG_MEMORY_CANDIDATE_TOP_K=5
HMDP_AI_RAG_MEMORY_TOP_K=2

# Set this only when serving a frontend directory outside this repository.
# HMDP_FRONTEND_DIR=D:/path/to/hmdp/frontend

# 仅对丢失前序消息的接口启用；须使用inline或关闭Skill，不支持native工具角色。
HMDP_AI_SINGLE_MESSAGE_COMPAT=false
